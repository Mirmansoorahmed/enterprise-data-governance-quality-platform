{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/dgqp/ropa.schema.json",
  "title": "Record of Processing Activities (POL-GDPR-04)",
  "description": "Electronic RoPA with the GDPR Art. 30(1) field set, for the synthetic Customer and HR processing activities. Illustrative lab artefact, not a compliance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["activities"],
  "properties": {
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activity_id", "controller", "purposes",
          "categories_of_data_subjects", "categories_of_personal_data",
          "categories_of_recipients", "retention_time_limits",
          "security_measures"
        ],
        "properties": {
          "activity_id": { "type": "string", "minLength": 1 },
          "controller": { "type": "string", "minLength": 1 },
          "dpo": { "type": "string" },
          "purposes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "categories_of_data_subjects": { "type": "array", "items": { "type": "string" } },
          "categories_of_personal_data": { "type": "array", "items": { "type": "string" } },
          "categories_of_recipients": { "type": "array", "items": { "type": "string" } },
          "third_country_transfers": { "type": "string" },
          "retention_time_limits": { "type": "string", "minLength": 1 },
          "security_measures": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
