{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/dgqp/raci.schema.json",
  "title": "Ownership / RACI register (GOV-RACI-01)",
  "description": "Named Data Owner (accountable) and Data Steward (Datenverantwortlicher, responsible) for every critical element. The steward is not the GDPR Art. 4(7) controller.",
  "type": "object",
  "additionalProperties": false,
  "required": ["elements"],
  "properties": {
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element_id", "domain", "owner", "steward"],
        "properties": {
          "element_id": { "type": "string", "minLength": 1 },
          "domain": {
            "type": "string",
            "enum": ["Customer", "Product", "Finance", "HR", "cross-domain"]
          },
          "owner": { "type": "string", "minLength": 1 },
          "steward": { "type": "string", "minLength": 1 },
          "dpo_consulted": { "type": "boolean" }
        }
      }
    }
  }
}
