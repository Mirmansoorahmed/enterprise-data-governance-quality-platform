{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/dgqp/run-file.schema.json",
  "title": "DGQP eval run file",
  "description": "A committed measurement. Every published number must trace to one of these, carrying a UTC timestamp and the git SHA of the code that produced it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "generated_at", "git_sha", "profile", "metrics"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["scorecard", "coverage", "demo_duration", "issue_cycle", "hybrid"]
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "git_sha": { "type": "string", "minLength": 7 },
    "profile": { "type": "string", "enum": ["oss", "hybrid"] },
    "metrics": { "type": "object" },
    "notes": { "type": "string" }
  }
}
